# Supabase project: kageflow (AfroSync org, Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: server-side export document extraction (OpenAI-compatible chat completions).
# Base URL includes the API version, for example https://api.openai.com/v1.
# Leave blank to use the local labelled-field parser instead. The model only proposes fields;
# a person confirms them and nothing is written to the case from model output.
EXPORT_AI_BASE_URL=
EXPORT_AI_API_KEY=
EXPORT_AI_MODEL=
